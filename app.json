{
  "expo": {
    "name": "FenuaSIM",
    "slug": "fenuasim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "fenuasim",
    "splash": {
      "image": "./assets/images/logo-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#D251D8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fenuasim.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fenuasim.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3e92760-d9f5-45c6-afcd-ec19d3a6daf5"
      }
    },
    "owner": "tomleb987"
  }
}
